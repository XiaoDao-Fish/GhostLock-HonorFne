# Windows checkout safety: shell scripts MUST stay LF (CRLF -> "bad interpreter").
* text=auto
*.sh text eol=lf
*.command text eol=lf
# .bat must keep CRLF in the blob itself: git archive (ZIP download) and raw
# downloads do NOT apply eol conversion. An LF-only .bat breaks `goto :label`
# in cmd.exe and the script exits immediately when double-clicked.
*.bat -text

# Markdown / Gradle / Kotlin / XML: normalize to LF in the repository.
*.md text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Binaries: never touch
*.ko binary
*.apk binary
*.zip binary
*.jar binary
*.png binary
*.jpg binary
*.keystore binary
ksud binary
magiskpolicy binary
ghostlock binary
e binary
load_ko binary
kmsg_dumper binary
fne_syms.txt binary
kallsyms_names binary
