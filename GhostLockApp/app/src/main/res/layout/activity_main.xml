<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass stage rebuilt on the HonorRoot design system.
     Every legacy view id is preserved so MainActivity keeps working. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_bg"
    android:clipChildren="false">

    <!-- Diffuse colour orbs, softly blurred at runtime on API 31 and above. -->
    <View
        android:id="@+id/orbBlue"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-110dp"
        android:layout_marginEnd="-110dp"
        android:background="@drawable/glass_orb_blue" />

    <View
        android:id="@+id/orbPurple"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-120dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/glass_orb_purple" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingStart="@dimen/ds_page_pad"
        android:paddingTop="@dimen/ds_space_8"
        android:paddingEnd="@dimen/ds_page_pad"
        android:paddingBottom="@dimen/ds_space_4">

        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- HOME. One focal point: the clock. Everything else steps back. -->
            <ScrollView
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/ds_space_6">

                    <TextView
                        android:id="@+id/homeClockCaption"
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_clock_caption" />

                    <TextView
                        android:id="@+id/tvClock"
                        style="@style/HonorRoot.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_1"
                        android:text="00:00:00" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/HonorRoot.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2" />

                    <TextView
                        android:id="@+id/tvGreeting"
                        style="@style/HonorRoot.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:text="@string/home_greeting_morning" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:background="@drawable/glass_card"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_pad">

                        <TextView
                            style="@style/HonorRoot.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_device_caption" />

                        <TextView
                            android:id="@+id/tvDeviceModel"
                            style="@style/HonorRoot.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:text="@string/home_device_model" />

                        <TextView
                            android:id="@+id/tvKernel"
                            style="@style/HonorRoot.Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:letterSpacing="0"
                            android:text="@string/home_kernel" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/ds_space_5"
                            android:layout_marginBottom="@dimen/ds_space_5"
                            android:background="@color/ds_outline_variant" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ds_touch_min"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/rootStateDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ds_status_dot"
                                android:backgroundTint="@color/glass_warn" />

                            <TextView
                                style="@style/HonorRoot.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_3"
                                android:text="@string/home_label_root" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvRootState"
                                style="@style/HonorRoot.Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="@string/home_root_pending"
                                android:textColor="@color/glass_warn"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginTop="@dimen/ds_space_2"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/shizukuStateDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/ds_status_dot"
                                android:backgroundTint="@color/glass_warn" />

                            <TextView
                                style="@style/HonorRoot.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_3"
                                android:text="@string/home_label_shizuku" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvShizukuState"
                                style="@style/HonorRoot.Text.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end|center_vertical"
                                android:minHeight="@dimen/ds_touch_min"
                                android:paddingStart="@dimen/ds_space_2"
                                android:text="@string/home_shizuku_no"
                                android:textColor="@color/glass_warn"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            style="@style/HonorRoot.Text.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_5"
                            android:letterSpacing="0"
                            android:text="@string/home_shizuku_hint" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ROOT -->
            <LinearLayout
                android:id="@+id/pageRoot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/rootIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/HonorRoot.Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_root" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_1"
                        android:layout_marginBottom="@dimen/ds_space_8"
                        android:letterSpacing="0"
                        android:text="@string/root_intro_subtitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glass_card"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_card_pad">

                        <TextView
                            style="@style/HonorRoot.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/root_check_caption" />

                        <TextView
                            android:id="@+id/tvCompat"
                            style="@style/HonorRoot.Text.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_4"
                            android:text="@string/root_check_pending"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompatDetail"
                            style="@style/HonorRoot.Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_3"
                            android:textColor="@color/ds_on_surface_muted" />

                        <android.widget.Button
                            android:id="@+id/btnRefreshCompat"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginTop="@dimen/ds_space_5"
                            android:paddingStart="@dimen/ds_space_4"
                            android:paddingEnd="@dimen/ds_space_4"
                            android:stateListAnimator="@null"
                            android:text="@string/root_refresh" />
                    </LinearLayout>

                    <android.widget.Button
                        android:id="@+id/btnStartRoot"
                        style="@style/HonorRoot.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_btn_primary_h"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:stateListAnimator="@null"
                        android:text="@string/root_start"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rootLogPanel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_4"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0"
                        android:text="@string/hint_waiting"
                        android:textColor="@color/glass_warn" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/HonorRoot.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/root_log_caption"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <android.widget.Button
                            android:id="@+id/btnClear"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/ds_touch_min"
                            android:paddingStart="@dimen/ds_space_4"
                            android:paddingEnd="@dimen/ds_space_4"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_clear" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvLog"
                            style="@style/HonorRoot.Text.Log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/log_placeholder"
                            android:textIsSelectable="true" />
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3"
                        android:orientation="horizontal">

                        <android.widget.Button
                            android:id="@+id/btnConnect"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginEnd="@dimen/ds_space_1"
                            android:layout_weight="1"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_connect" />

                        <android.widget.Button
                            android:id="@+id/btnDeploy"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginStart="@dimen/ds_space_1"
                            android:layout_weight="1"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_deploy" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:orientation="horizontal">

                        <android.widget.Button
                            android:id="@+id/btnStatus"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginEnd="@dimen/ds_space_1"
                            android:layout_weight="1"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_status" />

                        <android.widget.Button
                            android:id="@+id/btnManagers"
                            style="@style/HonorRoot.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ds_touch_min"
                            android:layout_marginStart="@dimen/ds_space_1"
                            android:layout_weight="1"
                            android:stateListAnimator="@null"
                            android:text="@string/btn_managers" />
                    </LinearLayout>

                    <android.widget.Button
                        android:id="@+id/btnRoot"
                        style="@style/HonorRoot.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_touch_min"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_root"
                        android:textColor="@color/ds_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ABOUT -->
            <ScrollView
                android:id="@+id/pageAbout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:background="@drawable/glass_card"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_6">

                    <TextView
                        style="@style/HonorRoot.Text.Brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />

                    <TextView
                        style="@style/HonorRoot.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/about_subtitle" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:background="@color/ds_outline_variant" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:text="@string/about_version_caption" />

                    <TextView
                        style="@style/HonorRoot.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/about_version" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:text="@string/about_author_caption" />

                    <TextView
                        style="@style/HonorRoot.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/about_author" />

                    <TextView
                        android:id="@+id/tvQq"
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_touch_min"
                        android:gravity="center_vertical"
                        android:letterSpacing="0"
                        android:text="@string/about_qq" />

                    <android.widget.Button
                        android:id="@+id/btnAuthorHome"
                        style="@style/HonorRoot.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ds_touch_min"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:stateListAnimator="@null"
                        android:text="@string/about_home_btn" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ds_space_8"
                        android:background="@color/ds_outline_variant" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_6"
                        android:text="@string/about_github_caption" />

                    <TextView
                        android:id="@+id/tvGithub"
                        style="@style/HonorRoot.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_2"
                        android:text="@string/about_github"
                        android:textColor="@color/glass_accent" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Floating capsule bar. Tap to switch, sliding frosted lens follows. -->
        <FrameLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_tabbar_h"
            android:layout_marginTop="@dimen/ds_space_4"
            android:background="@drawable/glass_pill"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/ds_space_1">

            <View
                android:id="@+id/tabIndicator"
                android:layout_width="100dp"
                android:layout_height="@dimen/ds_lens_h"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/glass_lens" />

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_home"
                        android:src="@drawable/ic_nav_home" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_1"
                        android:letterSpacing="0"
                        android:text="@string/nav_home"
                        android:textColor="@color/glass_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabRoot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="0.52"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_root"
                        android:src="@drawable/ic_nav_target" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_1"
                        android:letterSpacing="0"
                        android:text="@string/nav_root"
                        android:textColor="@color/glass_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabAbout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:alpha="0.52"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_about"
                        android:src="@drawable/ic_nav_info" />

                    <TextView
                        style="@style/HonorRoot.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_1"
                        android:letterSpacing="0"
                        android:text="@string/nav_about"
                        android:textColor="@color/glass_text" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
