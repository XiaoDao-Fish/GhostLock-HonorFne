<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_primary" />
            <corners android:radius="@dimen/ds_radius_btn" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3AFFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
