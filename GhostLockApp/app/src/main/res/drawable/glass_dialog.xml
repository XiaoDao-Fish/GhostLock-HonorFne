<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted modal card: opaque-enough dark base for legibility, top sheen,
     light hairline stroke. Matches the app's Liquid Glass language. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#ED0B0F17" />
            <corners android:radius="@dimen/ds_radius_card" />
            <stroke android:width="1dp" android:color="@color/ds_outline" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2AF2EAFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#14C4A2FF"
                android:centerColor="#00000000"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
