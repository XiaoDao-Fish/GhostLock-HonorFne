<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 卡片底：半透明玻璃填充 + 细描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="@dimen/ds_radius_card" />
            <stroke android:width="1dp" android:color="@color/ds_outline_variant" />
        </shape>
    </item>
    <!-- 斜向冷光：参考 Glassified 的白 0.25 到透明的高光带 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#1FFFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00000000"
                android:centerX="0.25"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- 顶部内侧高光：玻璃上沿受光 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
