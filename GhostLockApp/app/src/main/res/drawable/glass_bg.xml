<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 深空基底：对角线性渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF0B0F1A"
                android:centerColor="#FF121A2C"
                android:endColor="#FF070910"
                android:type="linear" />
        </shape>
    </item>
    <!-- 顶部霓虹青辉：呼应 MagicRoot 的霓虹点缀 -->
    <item android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="420dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#126FE0D2"
                android:centerColor="#082A5A66"
                android:endColor="#00000000" />
            <size android:width="700dp" android:height="700dp" />
        </shape>
    </item>
    <!-- 底部品牌紫辉 -->
    <item android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="380dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#1E946FDE"
                android:centerColor="#0C3A2A5C"
                android:endColor="#00000000" />
            <size android:width="640dp" android:height="640dp" />
        </shape>
    </item>
</layer-list>
