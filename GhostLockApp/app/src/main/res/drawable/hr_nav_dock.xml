<?xml version="1.0" encoding="utf-8"?>
                                         
                                          
                                                                                 
                                       
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
                                
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ksu_glass_fill" />
            <corners android:radius="@dimen/ds_nav_radius" />
            <stroke android:width="1dp" android:color="@color/ksu_glass_stroke" />
        </shape>
    </item>
                                
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ksu_glass_top"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/ds_nav_radius" />
        </shape>
    </item>
                                  
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/ksu_glass_sheen"
                android:centerColor="#00000000"
                android:endColor="#0DFFFFFF"
                android:centerX="0.32" />
            <corners android:radius="@dimen/ds_nav_radius" />
        </shape>
    </item>
</layer-list>
