<?xml version="1.0" encoding="utf-8"?>
<!-- KernelSU 3.3.0「悬浮底栏 + 液态玻璃」纯 XML 近似：
     半透明胶囊填充 + 白色高光描边 + 顶部受光 + 斜向冷光带（双光源），
     对应 FloatingBottomBar.kt 的 drawBackdrop/vibrancy/lens + iosIndicatorSpecular。
     不用 AGSL/RenderEffect（真机白块已证伪）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1) 半透明胶囊主体 + 白色高光描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ksu_glass_fill" />
            <corners android:radius="@dimen/ds_nav_radius" />
            <stroke android:width="1dp" android:color="@color/ksu_glass_stroke" />
        </shape>
    </item>
    <!-- 2) 顶部内侧受光（上沿白、向下淡出） -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/ksu_glass_top"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/ds_nav_radius" />
        </shape>
    </item>
    <!-- 3) 斜向冷白高光带（第二光源，左上受光） -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/ksu_glass_sheen"
                android:centerColor="#00000000"
                android:endColor="#0DFFFFFF"
                android:centerX="0.32" />
            <corners android:radius="@dimen/ds_nav_radius" />
        </shape>
    </item>
</layer-list>
