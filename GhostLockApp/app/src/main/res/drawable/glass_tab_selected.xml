<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_tab_active" />
            <corners android:radius="36dp" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="35dp" />
        </shape>
    </item>
    <!-- 斜向冷光：对应 MagicRoot 玻璃透镜第一光源法线 (0.5,-0.3,-0.05) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2AC4A2FF"
                android:centerColor="#00000000"
                android:endColor="#18FFFFFF"
                android:centerX="0.28" />
            <corners android:radius="34dp" />
        </shape>
    </item>
</layer-list>
