<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Liquid Glass is a dark-only design: pin the theme to dark so a light
         system setting cannot wash out the glass highlights. -->
    <style name="Theme.GhostLock" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/glass_window</item>
        <item name="android:statusBarColor">@color/glass_window</item>
        <item name="android:navigationBarColor">@color/glass_window</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
