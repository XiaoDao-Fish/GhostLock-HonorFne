         reference them; values now come from the tonal palette. -->
    <color name="glass_window">#FF0A0D13</color>
    <color name="glass_fill">#0DFFFFFF</color>
    <color name="glass_panel">@color/ds_surface_1</color>
    <color name="glass_nav">#CC141C29</color>
    <color name="glass_tab_active">#2EFFFFFF</color>
    <color name="glass_stroke">@color/ds_outline</color>
    <color name="glass_stroke_soft">@color/ds_outline_variant</color>
    <color name="glass_text">@color/ds_on_surface</color>
    <color name="glass_text_dim">@color/ds_on_surface_variant</color>
    <color name="glass_text_faint">@color/ds_on_surface_muted</color>
    <color name="glass_ok">@color/ds_success</color>
    <color name="glass_bad">@color/ds_error</color>
    <color name="glass_warn">@color/ds_warning</color>
