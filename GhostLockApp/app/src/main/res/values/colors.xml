<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="ic_launcher_background">#FF946FDE</color>

    <!-- Design DNA: deep space tech, restrained glass. Brand violet 946FDE is
         the primary anchor, expanded into an M3 style tonal palette.
         Dark only values, matching the pinned dark theme. -->
    <color name="ds_primary">#FFC4A2FF</color>
    <color name="ds_primary_pressed">#FFA884E8</color>
    <color name="ds_primary_container">#FF3A2A5C</color>
    <color name="ds_on_primary">#FF1A1030</color>
    <color name="ds_secondary">#FF9DBBFF</color>
    <color name="ds_tertiary">#FF6FE0D2</color>

    <color name="ds_surface">#FF0A0D13</color>
    <color name="ds_surface_1">#FF111823</color>
    <color name="ds_surface_2">#FF18212E</color>
    <color name="ds_outline">#33FFFFFF</color>
    <color name="ds_outline_variant">#1AFFFFFF</color>

    <!-- Text hierarchy. Muted still clears WCAG AA on the dark surface. -->
    <color name="ds_on_surface">#FFF5F7FF</color>
    <color name="ds_on_surface_variant">#FFC7CEDB</color>
    <color name="ds_on_surface_muted">#FF9AA5B5</color>

    <color name="ds_success">#FF7BE3A6</color>
    <color name="ds_warning">#FFFFD08A</color>
    <color name="ds_error">#FFFF958F</color>
    <color name="ds_log">#FF9BE7AE</color>

    <!-- Miuix inspired palette retained for legacy references. -->
    <color name="miuix_primary">#FF3482FF</color>
    <color name="miuix_primary_pressed">#FF277AF7</color>
    <color name="miuix_on_primary">#FFFFFFFF</color>
    <color name="miuix_bg">#FFFFFFFF</color>
    <color name="miuix_card">#FFF7F7F7</color>
    <color name="miuix_tertiary">#FFEAF2FF</color>
    <color name="miuix_tertiary_pressed">#FFDCEBFF</color>
    <color name="miuix_text">#FF000000</color>
    <color name="miuix_text_secondary">#99000000</color>
    <color name="miuix_divider">#1F000000</color>
    <color name="miuix_log_bg">#FF121417</color>
    <color name="miuix_log_text">#FF66D97F</color>
    <color name="miuix_log_title">#FFE8EAED</color>
    <color name="miuix_log_hint">#FFB9C0C8</color>
