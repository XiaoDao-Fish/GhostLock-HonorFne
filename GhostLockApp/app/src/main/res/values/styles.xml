<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dotted style names trigger implicit inheritance in aapt, so the two
         family roots must exist even though they carry no attributes. -->
    <style name="HonorRoot" />
    <style name="HonorRoot.Text" />
    <style name="HonorRoot.Button" />

    <!-- Type system. Every text view in the app uses one of these. -->
    <style name="HonorRoot.Text.Display">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">@dimen/ds_text_display</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HonorRoot.Text.Brand">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_brand</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HonorRoot.Text.Headline">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_headline</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="HonorRoot.Text.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:textColor">@color/ds_on_surface</item>
    </style>

    <style name="HonorRoot.Text.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textColor">@color/ds_on_surface_variant</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="HonorRoot.Text.Label">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="HonorRoot.Text.Log">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/ds_text_log</item>
        <item name="android:textColor">@color/ds_log</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- Button system: Filled primary > Tonal secondary. Both keep the same
         16dp radius and the same 44dp minimum touch target. -->
    <style name="HonorRoot.Button.Primary">
        <item name="android:background">@drawable/glass_btn_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_on_primary</item>
    </style>

    <style name="HonorRoot.Button.Tonal">
        <item name="android:background">@drawable/glass_btn</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textColor">@color/ds_on_surface_variant</item>
    </style>
</resources>
