<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HonorRoot" />
    <style name="HonorRoot.Text" />
    <style name="HonorRoot.Button" />

    <!-- Bold, tight type. No wide tracking, no thin display weights:
         this is a tool, the numbers have to look machined. -->

    <style name="HonorRoot.Text.Display">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">@dimen/ds_text_display</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HonorRoot.Text.Brand">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">@dimen/ds_text_brand</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HonorRoot.Text.Headline">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">@dimen/ds_text_headline</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HonorRoot.Text.Title">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="HonorRoot.Text.Body">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textColor">@color/ds_on_surface_variant</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="HonorRoot.Text.Label">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textColor">@color/ds_on_surface_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="HonorRoot.Text.Section">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="HonorRoot.Text.Log">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/ds_text_log</item>
        <item name="android:textColor">@color/hr_terminal_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="HonorRoot.Button.Primary">
        <item name="android:background">@drawable/hr_btn_primary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hr_btn_primary_text</item>
        <item name="android:paddingStart">@dimen/ds_space_4</item>
        <item name="android:paddingEnd">@dimen/ds_space_4</item>
    </style>

    <style name="HonorRoot.Button.Primary.Gate" parent="HonorRoot.Button.Primary">
        <item name="android:textColor">@color/hr_btn_primary_text</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
    </style>

    <style name="HonorRoot.Button.Tonal">
        <item name="android:background">@drawable/hr_btn_tonal</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ds_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ds_on_surface</item>
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
    </style>

    <style name="HonorRoot.Button.Mini" parent="HonorRoot.Button.Tonal">
        <item name="android:background">@drawable/hr_btn_mini</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textColor">@color/hr_terminal_title</item>
        <item name="android:paddingStart">@dimen/ds_space_3</item>
        <item name="android:paddingEnd">@dimen/ds_space_3</item>
    </style>

    <style name="HonorRoot.Chip">
        <item name="android:background">@drawable/hr_chip</item>
        <item name="android:paddingStart">@dimen/ds_space_2</item>
        <item name="android:paddingEnd">@dimen/ds_space_2</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">@dimen/ds_text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
